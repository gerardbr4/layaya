{
  "name": "layaya",
  "version": "1.0.0",
  "description": "Layaya restaurant website with D1 database and Pages Functions",
  "scripts": {
    "dev": "wrangler pages dev .",
    "deploy": "wrangler pages deploy .",
    "db:create": "wrangler d1 create layaya_db",
    "db:seed": "wrangler d1 execute layaya_db --file=layaya-d1-schema.sql",
    "db:query": "wrangler d1 execute layaya_db --interactive"
  },
  "devDependencies": {
    "wrangler": "^3.26.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
